# Copia este archivo a .env.local y completa los valores. No subas valores reales al repositorio.

# URL del backend (NestJS). Local: http://localhost:3001 — producción: https://api.mirufranco.com
NEXT_PUBLIC_API_URL=

# URL del frontend (usada por flujos de la app)
NEXT_PUBLIC_APP_URL=

# Dominio público para SEO (canonical, og:url, sitemap.xml, robots.txt).
# Opcional: si se omite se usa https://www.mirufranco.com
NEXT_PUBLIC_SITE_URL=

# Opcional
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
